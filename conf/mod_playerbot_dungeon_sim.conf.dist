[worldserver]

#
#   mod-playerbot-dungeon-sim (autonomous rebuild)
#
#   Assembles real bot parties and hands them to mod-dungeon-clear to actually
#   run the dungeon. XP and loot come from real kills — there is no simulated
#   award system. Requires mod-dungeon-clear with:
#       DungeonClear.AllowAutonomousBotRuns = 1
#

#
#    PlayerbotDungeonSim.Enable
#        Master switch for the autonomous runner.
#        Default: 1
#
PlayerbotDungeonSim.Enable = 1

#
#    PlayerbotDungeonSim.OnlyRandomBots
#        Only ever pull bots that the random-bot manager owns
#        (sRandomPlayerbotMgr->IsRandomBot). Strongly recommended: it guarantees
#        the runner never grabs a real player or a player's alt/added bot.
#        Default: 1
#
PlayerbotDungeonSim.OnlyRandomBots = 1

#
#    PlayerbotDungeonSim.TickSeconds
#        How often the runner tries to launch a NEW run. In-flight runs advance
#        every world tick regardless.
#        Default: 30
#
PlayerbotDungeonSim.TickSeconds = 30

#
#    PlayerbotDungeonSim.MaxConcurrentRuns
#        Cap on simultaneous active runs.
#        Default: 3
#
PlayerbotDungeonSim.MaxConcurrentRuns = 3

#
#    PlayerbotDungeonSim.MinBotLevel
#        Bots below this level are never pulled into a run.
#        Default: 15
#
PlayerbotDungeonSim.MinBotLevel = 15

#
#    PlayerbotDungeonSim.LevelBandWidth
#        Max level difference between the tank and any groupmate it pulls.
#        Default: 4
#
PlayerbotDungeonSim.LevelBandWidth = 4

#
#    PlayerbotDungeonSim.MinGroupSize
#        Minimum party size (including the tank) required to launch a run. A run
#        always needs at least one real tank-spec bot; this sets how many total
#        must be present. Lower = more runs but thinner parties.
#        Default: 3
#
PlayerbotDungeonSim.MinGroupSize = 3

#
#    PlayerbotDungeonSim.EntranceSpread
#        Yards of random scatter applied when teleporting party members to the
#        instance start, so they don't stack on one point.
#        Default: 4.0
#
PlayerbotDungeonSim.EntranceSpread = 4.0

#
#    PlayerbotDungeonSim.EnterTimeoutSeconds
#        How long to wait for the whole party to get inside before either
#        starting with whoever made it (if >= MinGroupSize) or recalling.
#        Default: 60
#
PlayerbotDungeonSim.EnterTimeoutSeconds = 60

#
#    PlayerbotDungeonSim.MaxRunMinutes
#        Hard cap on a single clear. If dungeon clear hasn't finished by then,
#        the party is recalled.
#        Default: 45
#
PlayerbotDungeonSim.MaxRunMinutes = 45

#
#    PlayerbotDungeonSim.StartupDelaySeconds
#        Delay after server start before the runner begins, to let playerbots
#        finish its login churn.
#        Default: 120
#
PlayerbotDungeonSim.StartupDelaySeconds = 120

#
#    PlayerbotDungeonSim.ReturnToCityOnEnd
#        When a run ends, teleport the bots back to their faction capital and
#        disband the group. With 0, just disband in place (leaving the dungeon
#        map still strips the dungeon-clear strategy).
#        Default: 1
#
PlayerbotDungeonSim.ReturnToCityOnEnd = 1

#
#   ---- progression / gearing ----
#   Guaranteed gearing on a real completion, pulled from the bosses' real loot
#   tables (creature_loot_template). This is what makes a fresh 60 climb from
#   greens -> dungeon blues -> tiers even if live looting was imperfect. Requires
#   the playerbot_dungeon_progression table (sql/).
#

#
#    PlayerbotDungeonSim.AwardEnabled
#        Award boss loot + progression when a run completes.
#        Default: 1
#
PlayerbotDungeonSim.AwardEnabled = 1

#
#    PlayerbotDungeonSim.AwardItemsPerRun
#        How many best slot-upgrades each bot may receive per completed run. Keep
#        low for gradual gearing.
#        Default: 1
#
PlayerbotDungeonSim.AwardItemsPerRun = 1

#
#    PlayerbotDungeonSim.AwardEquip
#        Auto-equip awarded upgrades (vs. leave in bags).
#        Default: 1
#
PlayerbotDungeonSim.AwardEquip = 1

#
#    PlayerbotDungeonSim.AwardGoldCopper
#        Copper awarded per bot per completed run (50000 = 5 gold).
#        Default: 50000
#
PlayerbotDungeonSim.AwardGoldCopper = 50000

#
#    PlayerbotDungeonSim.ClearsToAdvanceTier
#        Completed runs in the current content tier before the next unlocks.
#        Default: 8
#
PlayerbotDungeonSim.ClearsToAdvanceTier = 8

#
#    PlayerbotDungeonSim.LegendaryChance
#        1-in-N chance per completed run for a curated legendary of the bot's cap
#        (60: Thunderfury/Sulfuras, 70: Warglaives, 80: Shadowmourne). 0 = off.
#        Default: 2000
#
PlayerbotDungeonSim.LegendaryChance = 2000

#
#   ---- raids / sim mode ----
#

#
#    PlayerbotDungeonSim.SimDurationMinutes
#        Length of an offscreen raid "run" before its boss loot + tier credit are
#        awarded. Raids (20/40-man) can't be physically driven by dungeon clear,
#        so they progress in sim mode.
#        Default: 30
#
PlayerbotDungeonSim.SimDurationMinutes = 30

#
#    PlayerbotDungeonSim.RequireRealAttunement
#        If 1, a raid stage with a known attunement quest is gated on the leader
#        actually having completed it (falls back to dungeons if not). If 0, the
#        progression tier itself is the gate (bots earn their way up).
#        Default: 0
#
PlayerbotDungeonSim.RequireRealAttunement = 0

#
#   ---- social / LFG ----
#

#
#    PlayerbotDungeonSim.AnnounceLfgChat
#        Bots post in the LookingForGroup channel when a run forms (flavored as a
#        guild run vs a pug). Makes the world feel alive.
#        Default: 1
#
PlayerbotDungeonSim.AnnounceLfgChat = 1

#
#    PlayerbotDungeonSim.AllowPlayerJoin
#        Let a real player run ".dsim join [runId]" to ride along on a forming
#        5-man (they get teleported in with the party).
#        Default: 1
#
PlayerbotDungeonSim.AllowPlayerJoin = 1

#
#    PlayerbotDungeonSim.LegendaryMinTier
#        A bot must have climbed to at least this raid tier (see the ladder) to be
#        eligible for a legendary. Combined with the roll + gear + level gates, this
#        makes legendaries a payoff of long raid progression, never a leveling drop.
#        Default: 4
#
PlayerbotDungeonSim.LegendaryMinTier = 4

#
#    PlayerbotDungeonSim.LegendaryMinItemLevel
#        Gear gate: the bot's AVERAGE equipped item level must be at least this to
#        be legendary-eligible (i.e. already raid-geared). Tune per your top raid
#        tier's item level.
#        Default: 70
#
PlayerbotDungeonSim.LegendaryMinItemLevel = 70

#
#    PlayerbotDungeonSim.AnnounceGeneralChat
#        Also post the LFG/LFM line in the bot's CURRENT zone General channel
#        (city General while forming up, or the dungeon's zone General). Makes the
#        world feel alive.
#        Default: 1
#
PlayerbotDungeonSim.AnnounceGeneralChat = 1

#
#    PlayerbotDungeonSim.AnnounceTradeChat
#        Also post in Trade (city only). Off by default to avoid Trade spam.
#        Default: 0
#
PlayerbotDungeonSim.AnnounceTradeChat = 0

#
#   ---- city staging (populate the capitals) ----
#

#
#    PlayerbotDungeonSim.StageInCity
#        All-bot 5-man groups teleport to a random faction capital and loiter
#        there advertising LFG before heading into the dungeon, so the cities look
#        populated. Player-led groups skip this and go straight in. Coordinates
#        come from the server's game_tele table (stormwind/ironforge/darnassus,
#        orgrimmar/thunderbluff/undercity). Default: 1
#
PlayerbotDungeonSim.StageInCity = 1

#
#    PlayerbotDungeonSim.StageSeconds
#        How long a group loiters in the city before entering.  Default: 40
#
PlayerbotDungeonSim.StageSeconds = 40
